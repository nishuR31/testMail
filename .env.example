# ---------- Server ----------
PORT=3000
NODE_ENV=production
# REQUIRED in production, the API refuses to run without it. Send as "Authorization: Bearer <token>"; the UI prompts for it.
ACCESS_TOKEN=change-me-to-a-long-random-string
# Optional allow-list of recipients (addresses or domains). Strongly recommended for a test harness.
# ALLOWED_RECIPIENTS=you@gmail.com,yourcompany.com

# ---------- Redis (needed for Queued mode) ----------
# BullMQ speaks the Redis TCP protocol, so use the Upstash *Redis* endpoint, NOT the https REST url.
# Upstash console > your DB > "Connect" > ioredis / "TCP":
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR-DB.upstash.io:6379
# Also accepted: redis:// to an *.upstash.io host (auto-upgraded to TLS), the "redis-cli --tls -u ..." snippet,
# REDIS_HOST/REDIS_PORT/REDIS_PASSWORD/REDIS_TLS, or UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN (host+token reused).
# Special characters in the password must be percent-encoded (@ -> %40).
QUEUE_PREFIX=mailbench-prod
# Upstash bills per command: idle workers long-poll every N seconds (higher = fewer commands).
QUEUE_DRAIN_DELAY_S=30
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000
# Run the worker inside the web process (true) or only via `npm run worker` (false)
RUN_WORKER=true

# ---------- Resend ----------
RESEND_API_KEY=re_xxxxxxxx
# Without a verified domain: onboarding@resend.dev, and you can only send TO your own Resend account email.
RESEND_FROM=Mailbench <onboarding@resend.dev>
RESEND_DAILY_LIMIT=100
RESEND_RPS=2

# ---------- EmailJS ----------
# Account > Security: enable "Allow EmailJS API for non-browser applications" (needed for any server-side call).
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxx
EMAILJS_MONTHLY_LIMIT=200
EMAILJS_RPS=1
# Template must use: {{to_email}} (To field), {{subject}}, {{message}}, {{from_name}}, {{reply_to}}.
# Attachments only work with a "Variable attachment" on a paid plan. Put its parameter name here to enable it.
# EMAILJS_ATTACHMENT_PARAM=my_attachment

# ---------- Safety limits ----------
BURST_MAX_REAL=10
ATTACHMENT_MAX_KB=512
ENFORCE_QUOTA=true

# ---------- Simulators (free, fake providers for load/queue testing) ----------
ENABLE_SIMULATOR=false
# SIM_FAIL_RATE=0
