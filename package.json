{
  "name": "mailbench",
  "version": "1.0.0",
  "description": "Email delivery test suite: direct vs queued (BullMQ + Redis/Upstash) over EmailJS and Resend",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "NODE_ENV=production node server/index.js",
    "dev": "node --watch server/index.js",
    "worker": "NODE_ENV=production node server/worker.js",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "bullmq": "^6.7.8",
    "hono": "^4.13.14",
    "ioredis": "^6.0.0"
  }
}
